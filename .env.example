JWT_SECRET=change-me-in-production-min-16
NODE_ENV=development

# Прод API (VPS). У `next dev` клієнт ходить через проксі `/backend-api`.
NEXT_PUBLIC_API_URL=https://parta-api.diesel.zp.ua/api

# Локально: SSH-тунель, потім цей URL.
# ssh -p 443 -L 3307:127.0.0.1:3306 teamdeal@SERVER
DATABASE_URL=mysql://user:password@127.0.0.1:3307/parta?charset=utf8mb4&connect_timeout=5
